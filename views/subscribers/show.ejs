<h2>Détails de l'abonné</h2>
<div class="subscriber-details">
    <h3>
        <%= subscriber.name %>
    </h3>
    <p><strong>Email:</strong>
        <%= subscriber.email %>
    </p>
    <p><strong>Code Postal:</strong>
        <%= subscriber.zipCode %>
    </p>
    <form action="/subscribers/<%=subscriber._id %>/delete" method="POST"
        onsubmit="return confirm('Voulez-vous supprimer ?')">
        <button type="submit" class="btn btn-danger">Supprimer</button>
    </form>
</div>
<a href="/subscribers" class="btn btn-primary">Retour à la liste</a>
<a href="/subscribers/<%= subscriber._id %>/edit" class="btn btn-warning">Modifier</a>