<h2>Liste des abonnés</h2>
<form action="/subscribers/search" method="GET">
    <input type="text" name="name" placeholder="Nom" />
    <input type="text" name="postalCode" placeholder="Code Postal" />
    <button type="submit">Rechercher</button>
</form>

<% if (typeof message !=='undefined' ) { %>
    <p>
        <%= message %>
    </p>
    <% } %>


        <table class="table">
            <thead>
                <tr>
                    <th>Nom</th>
                    <th>Email</th>
                    <th>Code Postal</th>
                </tr>
            </thead>
            <tbody>
                <% subscribers.forEach(subscriber=> { %>
                    <tr>
                        <td><a href="<%= `/subscribers/${subscriber._id}` %>">
                                <%= subscriber.name %>
                            </a></td>
                        <td>
                            <%= subscriber.email %>
                        </td>
                        <td>
                            <%= subscriber.zipCode %>
                        </td>
                    </tr>
                    <% }); %>
            </tbody>
        </table>
        <a href="/subscribers/new">Créer un nouvel abonné</a>